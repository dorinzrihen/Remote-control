# Copy OUTSIDE this repository and chmod 600. No lighting token is needed.
# Used by run-butler.sh (edit for the destination laptop's LAN).
UNIREMOTE_LISTEN=192.168.1.10
UNIREMOTE_BROADCAST=192.168.1.255
# On macOS, set the absolute path to a Python 3.11+ interpreter, for example:
# UNIREMOTE_PYTHON=/opt/homebrew/bin/python3
